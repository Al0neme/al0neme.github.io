// ===== Anime 主题样式（清冷系 · 两栏布局） =====

mist = #7f95ab          // 冷雾蓝（主色）
mist-deep = #4f6478     // 深灰蓝（强调）
silver = #a9b5c1        // 银灰
text-main = #37424e     // 冷灰正文
text-sub = #71808f      // 浅灰副文
card-bg = rgba(255, 255, 255, 0.72)

*
  margin 0
  padding 0
  box-sizing border-box

html
  scroll-behavior smooth

body
  font-family "Zen Maru Gothic", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif
  color text-main
  line-height 1.8
  min-height 100vh

// 背景图 + 遮罩（更通透，让背景图清晰可见）
.bg
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  z-index -2
  background-size cover
  background-position center
  background-repeat no-repeat

.bg::after
  content ""
  position absolute
  inset 0
  background linear-gradient(160deg, rgba(240, 244, 248, 0.26), rgba(222, 231, 240, 0.22))

.wrapper
  max-width 1560px
  margin 0 auto
  padding 24px 24px 48px

// ===== 头部 =====
.site-header
  display flex
  align-items center
  justify-content space-between
  flex-wrap wrap
  gap 12px
  padding 14px 22px
  margin-bottom 24px
  background rgba(255, 255, 255, 0.55)
  backdrop-filter blur(12px)
  border-radius 20px
  box-shadow 0 4px 18px rgba(79, 100, 120, 0.1)

.site-title
  display flex
  align-items center
  gap 8px
  font-size 1.25rem
  font-weight 900
  color mist-deep
  text-decoration none

.title-icon
  font-size 1.3rem

.site-nav
  display flex
  gap 6px
  overflow-x auto

.nav-link
  padding 6px 16px
  border-radius 999px
  color text-sub
  text-decoration none
  font-weight 500
  white-space nowrap
  transition all 0.25s

.nav-link:hover
  color mist-deep
  background rgba(127, 149, 171, 0.14)

.nav-link.active
  color #fff
  background linear-gradient(135deg, mist, silver)
  box-shadow 0 3px 10px rgba(79, 100, 120, 0.25)

// ===== 两栏布局 =====
.layout
  display grid
  grid-template-columns minmax(0, 1fr) 320px
  gap 24px
  align-items start

.content
  min-width 0

.sidebar
  position sticky
  top 20px
  display flex
  flex-direction column
  gap 20px
  max-height calc(100vh - 40px)
  overflow-y auto
  scrollbar-width thin

// ===== 通用卡片 =====
.card
  background card-bg
  backdrop-filter blur(12px)
  border-radius 20px
  padding 24px
  margin-bottom 20px
  box-shadow 0 6px 24px rgba(55, 66, 78, 0.1)
  border 1px solid rgba(255, 255, 255, 0.5)

.sidebar .card
  margin-bottom 0
  padding 20px

// ===== 搜索卡片 =====
.search-box
  display flex
  align-items center
  gap 8px
  padding 6px 14px
  border-radius 999px
  background rgba(255, 255, 255, 0.8)
  border 2px solid rgba(127, 149, 171, 0.35)
  transition border-color 0.25s

.search-box:focus-within
  border-color mist

.search-icon
  font-size 0.9rem
  opacity 0.7

#search-input
  flex 1
  min-width 0
  border none
  outline none
  background transparent
  font-family inherit
  font-size 0.92rem
  color text-main
  padding 4px 0

#search-input::placeholder
  color text-sub

.search-results
  list-style none
  margin-top 12px
  display flex
  flex-direction column
  gap 4px

.search-results a
  display block
  padding 8px 12px
  border-radius 12px
  text-decoration none
  transition background 0.2s

.search-results a:hover
  background rgba(127, 149, 171, 0.14)

.sr-title
  display block
  font-weight 700
  font-size 0.92rem
  color mist-deep

.sr-snippet
  display block
  font-size 0.8rem
  color text-sub
  line-height 1.5
  margin-top 2px

.sr-snippet mark
  background rgba(127, 149, 171, 0.25)
  color mist-deep
  border-radius 4px
  padding 0 2px

.search-empty
  margin-top 10px
  font-size 0.85rem
  color text-sub
  text-align center

// ===== 个人资料卡（侧栏） =====
.profile-card
  text-align center

.avatar
  width 96px
  height 96px
  border-radius 50%
  object-fit cover
  border 3px solid #fff
  box-shadow 0 6px 20px rgba(79, 100, 120, 0.25)
  transition transform 0.3s
  margin-bottom 10px

.avatar:hover
  transform scale(1.06) rotate(2deg)

.profile-name
  font-size 1.4rem
  font-weight 900
  background linear-gradient(135deg, mist-deep, #8b9dae)
  -webkit-background-clip text
  background-clip text
  color transparent
  margin-bottom 2px

.profile-bio
  color text-sub
  font-size 0.9rem

.profile-location
  color text-sub
  font-size 0.85rem
  margin-top 2px

// ===== 个人标签 =====
.tag-groups
  margin-top 16px
  display flex
  flex-direction column
  gap 10px

.tag-group
  display flex
  flex-direction column
  align-items flex-start
  gap 6px

.tag-group-name
  font-weight 700
  color mist-deep
  font-size 0.85rem
  padding 2px 10px
  background rgba(127, 149, 171, 0.14)
  border-radius 999px
  white-space nowrap

.tag-pills
  display flex
  flex-wrap wrap
  gap 6px

.pill
  display inline-block
  padding 3px 12px
  border-radius 999px
  font-size 0.8rem
  font-weight 500
  color #fff
  box-shadow 0 2px 8px rgba(55, 66, 78, 0.12)

pill-colors = #7f95ab #8ba3b5 #6f8798 #93a2b0 #7d99a6 #8994a5

for i in 0..5
  .pill-{i}
    background pill-colors[i]

// ===== 社交链接 =====
.social-links
  margin-top 16px
  display flex
  justify-content center
  flex-wrap wrap
  gap 8px

.social-link
  padding 4px 14px
  border-radius 999px
  text-decoration none
  font-size 0.85rem
  font-weight 700
  color mist-deep
  border 2px solid rgba(127, 149, 171, 0.5)
  background rgba(255, 255, 255, 0.5)
  transition all 0.25s

.social-link:hover
  color #fff
  background linear-gradient(135deg, mist, silver)
  border-color transparent
  transform translateY(-2px)

// ===== 文章目录 =====
.toc-title
  display flex
  align-items center
  justify-content space-between
  font-size 1rem
  font-weight 900
  color mist-deep
  margin-bottom 10px
  padding-bottom 8px
  border-bottom 2px dashed rgba(127, 149, 171, 0.3)
  cursor pointer
  list-style none
  -webkit-tap-highlight-color transparent
  user-select none

.toc-title::-webkit-details-marker
  display none

.toc-icon
  width 1.15em
  height 1.15em
  flex-shrink 0
  color mist-deep

.toc-title::after
  content "▾"
  font-size 0.85rem
  color text-sub
  transition transform 0.25s

details:not([open]) > .toc-title
  margin-bottom 0
  padding-bottom 0
  border-bottom none

details:not([open]) > .toc-title::after
  transform rotate(-90deg)

.toc-body
  font-size 0.88rem

.toc-body ol, .toc-body ul
  list-style none
  padding-left 0

.toc-body ol ol, .toc-body ul ul,
.toc-body ol ul, .toc-body ul ol
  padding-left 14px

.toc-body li
  margin 2px 0

.toc-link
  display block
  padding 4px 10px
  border-radius 10px
  color text-sub
  text-decoration none
  line-height 1.5
  transition all 0.2s
  border-left 2px solid transparent

.toc-link:hover
  color mist-deep
  background rgba(127, 149, 171, 0.12)
  border-left-color mist

.toc-text
  word-break break-all

// ===== 文章列表 =====
.post-item
  transition transform 0.25s

.post-item:hover
  transform translateY(-3px)

.post-title
  font-size 1.35rem
  font-weight 900

.post-title a
  color text-main
  text-decoration none

.post-title a:hover
  color mist-deep

.post-date
  display inline-block
  margin-top 4px
  font-size 0.85rem
  color text-sub

.post-excerpt
  margin-top 10px
  color text-sub
  font-size 0.95rem

.read-more
  display inline-block
  margin-top 12px
  padding 6px 18px
  border-radius 999px
  font-size 0.88rem
  font-weight 700
  text-decoration none
  color #fff
  background linear-gradient(135deg, mist, silver)
  box-shadow 0 3px 10px rgba(79, 100, 120, 0.22)
  transition transform 0.2s

.read-more:hover
  transform translateY(-2px)

// ===== 分页 =====
.pagination
  display flex
  align-items center
  justify-content center
  gap 16px
  margin-top 8px

.page-btn
  padding 8px 20px
  border-radius 999px
  text-decoration none
  font-weight 700
  font-size 0.9rem
  color mist-deep
  background rgba(255, 255, 255, 0.7)
  border 2px solid mist
  transition all 0.25s

.page-btn:hover
  color #fff
  background linear-gradient(135deg, mist, silver)
  border-color transparent

.page-info
  color text-sub
  font-size 0.9rem

// ===== 文章 / 页面正文 =====
.post-full .post-title,
.page-full .post-title
  text-align center
  font-size 1.7rem
  margin-bottom 2px

.post-full .post-date
  display block
  text-align center
  margin-bottom 18px

.post-body
  font-size 1rem
  word-wrap break-word

.post-body h1, .post-body h2, .post-body h3, .post-body h4
  margin 1.2em 0 0.6em
  font-weight 900
  color mist-deep
  scroll-margin-top 20px

.post-body h1
  font-size 1.5rem
.post-body h2
  font-size 1.3rem
  padding-left 10px
  border-left 4px solid mist

.post-body h3
  font-size 1.1rem

.post-body p
  margin 0.8em 0

.post-body ul, .post-body ol
  margin 0.8em 0
  padding-left 1.6em

.post-body li
  margin 0.3em 0

.post-body a
  color mist-deep
  text-decoration underline
  text-decoration-color rgba(127, 149, 171, 0.5)

.post-body a:hover
  color #8b9dae

.post-body blockquote
  margin 1em 0
  padding 10px 18px
  border-left 4px solid silver
  background rgba(169, 181, 193, 0.12)
  border-radius 0 12px 12px 0
  color text-sub

.post-body code
  padding 2px 8px
  border-radius 8px
  background rgba(127, 149, 171, 0.14)
  color mist-deep
  font-size 0.88em
  font-family "SFMono-Regular", Consolas, monospace

.post-body pre
  margin 1em 0
  padding 16px
  border-radius 14px
  background #28303a
  color #e4eaf0
  overflow-x auto
  line-height 1.6

.post-body pre code
  padding 0
  background none
  color inherit

.post-body img
  max-width 100%
  border-radius 14px
  box-shadow 0 4px 16px rgba(0, 0, 0, 0.12)

.post-body table
  width 100%
  border-collapse collapse
  margin 1em 0

.post-body th, .post-body td
  padding 8px 12px
  border 1px solid rgba(127, 149, 171, 0.3)

.post-body th
  background rgba(127, 149, 171, 0.12)
  font-weight 700

.post-body hr
  border none
  text-align center
  margin 1.5em 0

.post-body hr::before
  content "❄ ❄ ❄"
  letter-spacing 8px
  color silver

// 上一篇 / 下一篇
.post-nav
  display flex
  justify-content space-between
  gap 12px
  margin-top 28px
  padding-top 18px
  border-top 2px dashed rgba(127, 149, 171, 0.35)

.post-nav-item
  max-width 46%
  padding 8px 16px
  border-radius 14px
  background rgba(127, 149, 171, 0.12)
  color mist-deep
  text-decoration none
  font-size 0.9rem
  font-weight 700
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  transition background 0.25s

.post-nav-item:hover
  background rgba(127, 149, 171, 0.24)

// ===== 归档 =====
.archive-full .post-title
  text-align center
  margin-bottom 18px

.archive-year
  font-size 1.2rem
  font-weight 900
  color mist-deep
  margin 18px 0 8px

.archive-list
  list-style none

.archive-item
  display flex
  align-items baseline
  gap 14px
  padding 8px 12px
  border-radius 12px
  transition background 0.2s

.archive-item:hover
  background rgba(127, 149, 171, 0.1)

.archive-date
  flex-shrink 0
  font-size 0.85rem
  color text-sub
  font-family Consolas, monospace

.archive-item a
  color text-main
  text-decoration none
  font-weight 500

.archive-item a:hover
  color mist-deep

// ===== 页脚 =====
.site-footer
  text-align center
  padding 20px 0 8px
  color text-sub
  font-size 0.85rem

.site-footer a
  color mist-deep
  text-decoration none

// ===== 响应式（移动端适配） =====
@media (max-width: 960px)
  .bg::after
    background linear-gradient(160deg, rgba(240, 244, 248, 0.45), rgba(222, 231, 240, 0.4))

  .wrapper
    padding 14px unquote("max(12px, env(safe-area-inset-right))") calc(32px + env(safe-area-inset-bottom)) unquote("max(12px, env(safe-area-inset-left))")

  // 侧栏置顶，紧凑化
  .sidebar
    order -1
    position static
    max-height none
    overflow visible
    gap 14px

  .layout
    grid-template-columns 1fr
    gap 18px

  // 头部紧凑
  .site-header
    padding 10px 16px
    border-radius 16px
    margin-bottom 18px
    gap 8px

  .site-title
    font-size 1.1rem

  .site-nav
    width 100%
    gap 4px
    -webkit-overflow-scrolling touch
    scrollbar-width none

  .site-nav::-webkit-scrollbar
    display none

  .nav-link
    padding 8px 14px
    font-size 0.9rem

  // 卡片紧凑
  .card
    padding 16px
    border-radius 16px
    margin-bottom 14px

  .sidebar .card
    padding 14px 16px

  // 资料卡横向紧凑布局
  .profile-card
    display grid
    grid-template-columns auto minmax(0, 1fr)
    grid-template-areas "av nm" "av bi" "av lo" "tg tg" "so so"
    column-gap 14px
    row-gap 2px
    text-align left

  .avatar
    grid-area av
    width 64px
    height 64px
    border-width 2px
    align-self center
    margin-bottom 0

  .avatar:hover
    transform none

  .profile-name
    grid-area nm
    font-size 1.2rem
    align-self end

  .profile-bio
    grid-area bi
    font-size 0.85rem
    line-height 1.5

  .profile-location
    grid-area lo
    font-size 0.8rem

  .tag-groups
    grid-area tg
    margin-top 12px
    gap 8px

  .tag-group
    flex-direction row
    align-items center
    flex-wrap wrap

  .social-links
    grid-area so
    justify-content flex-start
    margin-top 12px

  // 正文适配
  body
    font-size 15px

  .post-item:hover
    transform none

  .post-title
    font-size 1.15rem

  .post-full .post-title,
  .page-full .post-title
    font-size 1.35rem

  .post-body
    font-size 0.95rem

  .post-body pre
    padding 12px
    border-radius 12px
    font-size 0.85rem

  .post-body img
    border-radius 10px

  .post-body table
    display block
    overflow-x auto

  .post-nav
    flex-direction column

  .post-nav-item
    max-width 100%

  .read-more, .page-btn, .social-link
    -webkit-tap-highlight-color transparent

  .archive-item
    padding 10px 8px

  // 文章目录 → 右下角书籍图标按钮，点击弹出抽屉
  .sidebar .toc-card
    position fixed
    right 14px
    bottom calc(20px + env(safe-area-inset-bottom))
    z-index 60
    margin 0
    padding 0
    background none
    border none
    box-shadow none
    backdrop-filter none

  // 移动端目录按钮：书籍图标（SVG，不依赖字体）
  .toc-card .toc-title
    width 46px
    height 46px
    padding 0
    margin 0
    position relative
    border none
    background none
    justify-content center
    color mist-deep
    -webkit-tap-highlight-color transparent
    // 白色外发光 + 深色投影，任意背景上都清晰可见
    filter drop-shadow(0 0 5px rgba(255, 255, 255, 0.95)) drop-shadow(0 2px 6px rgba(55, 66, 78, 0.45))
    transition transform 0.25s

  .toc-card .toc-title:active
    transform scale(0.9)

  .toc-card .toc-icon
    width 30px
    height 30px

  .toc-card .toc-label
    display none

  .toc-card .toc-title::after
    display none

  .toc-card[open] .toc-title
    margin 0
    padding 0
    border none

  .toc-card .toc-body
    position fixed
    right 14px
    bottom calc(76px + env(safe-area-inset-bottom))
    width unquote("min(78vw, 300px)")
    max-height 60vh
    overflow-y auto
    padding 14px 16px
    border-radius 20px
    border 1px solid rgba(255, 255, 255, 0.5)
    // 抽屉同步液态玻璃质感
    background linear-gradient(150deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.3))
    backdrop-filter blur(24px) saturate(180%)
    -webkit-backdrop-filter blur(24px) saturate(180%)
    box-shadow 0 10px 36px rgba(55, 66, 78, 0.25), inset 0 1px 2px rgba(255, 255, 255, 0.8), inset 0 -1px 2px rgba(255, 255, 255, 0.25)
    font-size 0.88rem

  .toc-card .toc-body .toc-link
    color #4a5d70

  .toc-card .toc-body .toc-link:hover
    color mist-deep

  .site-footer
    padding 14px 0 6px
    font-size 0.8rem
