<article class="card post-full">
  <h1 class="post-title"><%= page.title %></h1>
  <time class="post-date" datetime="<%= date_xml(page.date) %>">🗓 <%= date(page.date, config.date_format) %></time>
  <div class="post-body">
    <%- page.content %>
  </div>

  <nav class="post-nav">
    <% if (page.prev) { %>
      <a class="post-nav-item" href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a>
    <% } else { %>
      <span></span>
    <% } %>
    <% if (page.next) { %>
      <a class="post-nav-item" href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a>
    <% } %>
  </nav>
</article>
