<section class="card archive-full">
  <h1 class="post-title">归档</h1>
  <% let lastYear = null; %>
  <% page.posts.each(post => { %>
    <% const y = date(post.date, 'YYYY'); %>
    <% if (y !== lastYear) { %>
      <% if (lastYear !== null) { %></ul><% } %>
      <h2 class="archive-year">❄ <%= y %></h2>
      <ul class="archive-list">
      <% lastYear = y; %>
    <% } %>
    <li class="archive-item">
      <time class="archive-date" datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM-DD') %></time>
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    </li>
  <% }) %>
  <% if (lastYear !== null) { %></ul><% } %>

  <% if (page.total > 1) { %>
    <nav class="pagination">
      <% if (page.prev) { %>
        <a class="page-btn" href="<%- url_for(page.prev_link) %>">← 上一页</a>
      <% } %>
      <span class="page-info"><%= page.current %> / <%= page.total %></span>
      <% if (page.next) { %>
        <a class="page-btn" href="<%- url_for(page.next_link) %>">下一页 →</a>
      <% } %>
    </nav>
  <% } %>
</section>
