<section class="post-list">
  <% page.posts.each(post => { %>
    <article class="card post-item">
      <h2 class="post-title"><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
      <time class="post-date" datetime="<%= date_xml(post.date) %>">🗓 <%= date(post.date, config.date_format) %></time>
      <% if (post.excerpt) { %>
        <div class="post-excerpt"><%- post.excerpt %></div>
      <% } else if (post.content) { %>
        <div class="post-excerpt"><%= truncate(strip_html(post.content), {length: 120}) %>…</div>
      <% } %>
      <a class="read-more" href="<%- url_for(post.path) %>">阅读全文 →</a>
    </article>
  <% }) %>

  <% if (page.total > 1) { %>
    <nav class="pagination">
      <% if (page.prev) { %>
        <a class="page-btn" href="<%- url_for(page.prev_link) %>">← 上一页</a>
      <% } %>
      <span class="page-info"><%= page.current %> / <%= page.total %></span>
      <% if (page.next) { %>
        <a class="page-btn" href="<%- url_for(page.next_link) %>">下一页 →</a>
      <% } %>
    </nav>
  <% } %>
</section>
